<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
	<name>Sample Trip</name>

	<Style id="landmark-style">
		<IconStyle>
			<color>ff0000ff</color>
			<scale>1.3</scale>
			<Icon>
				<href>https://maps.google.com/mapfiles/kml/paddle/red-circle.png</href>
			</Icon>
		</IconStyle>
		<LabelStyle>
			<color>ffffffff</color>
			<scale>1.1</scale>
		</LabelStyle>
	</Style>

	<Style id="route-style">
		<LineStyle>
			<color>7f00ffff</color>
			<width>4</width>
		</LineStyle>
	</Style>

	<Style id="park-style">
		<LineStyle>
			<color>ff59862d</color>
			<width>2</width>
		</LineStyle>
		<PolyStyle>
			<color>7f59862d</color>
		</PolyStyle>
	</Style>

	<Folder>
		<name>Landmarks</name>
		<Placemark>
			<name>Golden Gate Bridge</name>
			<description>Suspension bridge in San Francisco</description>
			<styleUrl>#landmark-style</styleUrl>
			<Point>
				<coordinates>-122.4783,37.8199,67</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>Alcatraz Island</name>
			<description>Former federal prison</description>
			<styleUrl>#landmark-style</styleUrl>
			<Point>
				<coordinates>-122.4230,37.8267,41</coordinates>
			</Point>
		</Placemark>
	</Folder>

	<Folder>
		<name>Routes</name>
		<Folder>
			<name>Scenic Drives</name>
			<Placemark>
				<name>Bridge to Marin Headlands</name>
				<styleUrl>#route-style</styleUrl>
				<LineString>
					<coordinates>-122.4783,37.8199,67 -122.4833,37.8324,120 -122.4990,37.8267,200 -122.5265,37.8324,150</coordinates>
				</LineString>
			</Placemark>
		</Folder>
	</Folder>

	<Folder>
		<name>Areas</name>
		<Placemark>
			<name>Presidio Area</name>
			<description>Polygon with a hole (inner boundary)</description>
			<styleUrl>#park-style</styleUrl>
			<Polygon>
				<outerBoundaryIs>
					<LinearRing>
						<coordinates>
							-122.4790,37.7880,0
							-122.4460,37.7880,0
							-122.4460,37.8060,0
							-122.4790,37.8060,0
							-122.4790,37.7880,0
						</coordinates>
					</LinearRing>
				</outerBoundaryIs>
				<innerBoundaryIs>
					<LinearRing>
						<coordinates>-122.4680,37.7940,0 -122.4580,37.7940,0 -122.4580,37.8000,0 -122.4680,37.8000,0 -122.4680,37.7940,0</coordinates>
					</LinearRing>
				</innerBoundaryIs>
			</Polygon>
		</Placemark>
	</Folder>

</Document>
</kml>
